    "living": {"zone": "lounge", "influences": {"lounge": 1, "sleep": 0.35, "office": 0.35}, "priority": 0, "lock_group": "living"},
    "study": {"zone": "office", "influences": {"office": 1, "lounge": 0.35}, "priority": 0, "lock_group": "study"}
  },
  "connections": [
    {"from": "sleep", "to": "lounge", "coupling": 0.35},
    {"from": "lounge", "to": "office", "coupling": 0.35}
  ],
  "opposite_operation": {"enabled": false, "max_cross_influence": 0.1}
